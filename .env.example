# ==========================================
# Variáveis de Ambiente - Sistema de Agendamento
# ==========================================

# Aplicação
PROJECT_NAME="Agendamento Barber & Salão"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="troque_esta_chave_secreta_por_uma_string_aleatoria_longa_em_producao"
AES_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=" # Base64 de 32 bytes

# Segurança JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Banco de Dados PostgreSQL (Assíncrono com asyncpg)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appointment_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/appointment_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
VITE_API_BASE_URL="http://localhost:8000"
